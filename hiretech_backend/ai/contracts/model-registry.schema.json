{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hiretech.example/schemas/ai/model-registry/1.0.0",
  "title": "HireTech Model Registry Entry",
  "description": "Metadata for one approved model deployment. Credential values are prohibited; only secret-manager references are allowed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "registry_version",
    "environment",
    "status",
    "provider",
    "model",
    "roles",
    "capabilities",
    "data_governance",
    "credentials",
    "limits",
    "decoding_defaults",
    "compatibility",
    "benchmark",
    "health_policy",
    "approval",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_id": {
      "type": "string",
      "format": "uuid"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEVELOPMENT",
        "STAGING",
        "PRODUCTION"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "VALIDATING",
        "APPROVED",
        "ACTIVE",
        "DISABLED",
        "RETIRED"
      ]
    },
    "provider": {
      "$ref": "#/$defs/provider"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "INTERVIEWER",
          "EVALUATOR"
        ]
      }
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "data_governance": {
      "$ref": "#/$defs/dataGovernance"
    },
    "credentials": {
      "$ref": "#/$defs/credentials"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "decoding_defaults": {
      "$ref": "#/$defs/decodingDefaults"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "benchmark": {
      "$ref": "#/$defs/benchmark"
    },
    "health_policy": {
      "$ref": "#/$defs/healthPolicy"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "retired_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_id",
        "display_name",
        "api_protocol",
        "endpoint_reference",
        "processing_regions"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "api_protocol": {
          "type": "string",
          "enum": [
            "OPENAI_COMPATIBLE",
            "PROVIDER_NATIVE",
            "SELF_HOSTED"
          ]
        },
        "endpoint_reference": {
          "type": "string",
          "pattern": "^config://[A-Za-z0-9._/-]+$"
        },
        "processing_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{2,32}$"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "provider_model_version",
        "release_channel"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider_model_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          ]
        },
        "release_channel": {
          "type": "string",
          "enum": [
            "PINNED",
            "STABLE_ALIAS"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streaming",
        "strict_json_schema",
        "tool_calling",
        "languages",
        "task_types"
      ],
      "properties": {
        "streaming": {
          "type": "boolean"
        },
        "strict_json_schema": {
          "type": "boolean"
        },
        "tool_calling": {
          "type": "boolean"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
          }
        },
        "task_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "TECHNICAL_DISCUSSION",
              "CODING",
              "SYSTEM_DESIGN",
              "DEBUGGING",
              "EVIDENCE_EVALUATION",
              "REPORT_GENERATION"
            ]
          }
        }
      }
    },
    "dataGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_data_classes",
        "training_use",
        "human_provider_review",
        "provider_retention_hours",
        "approved_processing_regions",
        "cross_border_transfer_basis_reference",
        "subprocessor_list_reference",
        "deletion_process_reference"
      ],
      "properties": {
        "allowed_data_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "RESTRICTED"
            ]
          }
        },
        "training_use": {
          "const": "DISABLED"
        },
        "human_provider_review": {
          "const": "DISABLED"
        },
        "provider_retention_hours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 720
        },
        "approved_processing_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{2,32}$"
          }
        },
        "cross_border_transfer_basis_reference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^policy://[A-Za-z0-9._/-]+$"
            }
          ]
        },
        "subprocessor_list_reference": {
          "type": "string",
          "pattern": "^policy://[A-Za-z0-9._/-]+$"
        },
        "deletion_process_reference": {
          "type": "string",
          "pattern": "^policy://[A-Za-z0-9._/-]+$"
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_reference",
        "rotation_policy_reference"
      ],
      "properties": {
        "secret_reference": {
          "type": "string",
          "pattern": "^secret://[A-Za-z0-9._/-]+$",
          "description": "Opaque secret-manager reference. A credential value is never valid here."
        },
        "rotation_policy_reference": {
          "type": "string",
          "pattern": "^policy://[A-Za-z0-9._/-]+$"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_window_tokens",
        "maximum_input_tokens",
        "maximum_output_tokens",
        "request_timeout_ms",
        "maximum_retries",
        "cost_currency",
        "maximum_cost_minor_units"
      ],
      "properties": {
        "context_window_tokens": {
          "type": "integer",
          "minimum": 1024
        },
        "maximum_input_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "request_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "maximum_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "cost_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "maximum_cost_minor_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "decodingDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "seed_supported"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "seed_supported": {
          "type": "boolean"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_schema_versions",
        "prompt_versions",
        "rubric_versions",
        "routing_policy_versions"
      ],
      "properties": {
        "output_schema_versions": {
          "$ref": "#/$defs/versionList"
        },
        "prompt_versions": {
          "$ref": "#/$defs/versionList"
        },
        "rubric_versions": {
          "$ref": "#/$defs/versionList"
        },
        "routing_policy_versions": {
          "$ref": "#/$defs/versionList"
        }
      }
    },
    "versionList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_version",
        "evaluation_run_id",
        "completed_at",
        "passed_required_gates",
        "report_reference"
      ],
      "properties": {
        "dataset_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "evaluation_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "passed_required_gates": {
          "type": "boolean"
        },
        "report_reference": {
          "type": "string",
          "pattern": "^artifact://[A-Za-z0-9._/-]+$"
        }
      }
    },
    "healthPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_interval_seconds",
        "failure_window_seconds",
        "minimum_requests",
        "open_failure_rate",
        "half_open_probe_count"
      ],
      "properties": {
        "probe_interval_seconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        "failure_window_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        "minimum_requests": {
          "type": "integer",
          "minimum": 1
        },
        "open_failure_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "half_open_probe_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "technical_approved_by",
        "security_approved_by",
        "privacy_approved_by",
        "approved_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "format": "uuid"
        },
        "technical_approved_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uuid"
            }
          ]
        },
        "security_approved_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uuid"
            }
          ]
        },
        "privacy_approved_by": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uuid"
            }
          ]
        },
        "approved_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        }
      }
    }
  }
}
