# Real backend mode is the default. Use "mock" only for an isolated UI demo.
# Mock mode never connects to or receives data from a backend.
NEXT_PUBLIC_DATA_MODE=api

# Browser-visible backend origin. Electron also copies this public origin into
# its generated runtime policy so CSP and the renderer always agree.
# Remote production origins must use HTTPS. Do not place secrets here.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable only after the backend allowlist is provisioned and reviewed.
NEXT_PUBLIC_GRAPHQL_PERSISTED_OPERATIONS=false

# Electron main-process-only development override. It must remain loopback;
# remote renderer pages are rejected because the preload exposes privileged IPC.
HIRETECH_RENDERER_URL=http://localhost:3000

# Stable packaged-renderer port. When the backend is configured separately,
# allow http://localhost:3000, http://127.0.0.1:3000, and both localhost and
# 127.0.0.1 origins for this port in CORS_ALLOWED_ORIGINS.
HIRETECH_DESKTOP_PORT=3210
