{
  "name": "hiretech_frontend",
  "version": "0.1.0",
  "private": true,
  "description": "HireTech desktop and web application",
  "author": "HireTech",
  "desktopName": "hiretech",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "next dev --port 3000",
    "predev:desktop": "node electron/write-runtime-config.cjs",
    "dev:desktop": "electron electron/main.cjs --dev",
    "build": "npm run persisted-operations:check && npm run typecheck && next build --webpack",
    "build:web": "npm run persisted-operations:check && npm run typecheck && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:backend": "playwright test --config playwright.backend.config.ts",
    "test:e2e:backend:lifecycle": "playwright test e2e-backend/interview-lifecycle-backend.spec.ts --config playwright.backend.config.ts",
    "persisted-operations:generate": "node scripts/persisted-operations.mjs --write",
    "persisted-operations:check": "node scripts/persisted-operations.mjs --check",
    "persisted-operations:env": "node scripts/persisted-operations.mjs --env",
    "preelectron": "node electron/write-runtime-config.cjs",
    "electron": "electron electron/main.cjs",
    "electron:dev": "npm run dev:desktop",
    "preelectron:dist": "node electron/write-runtime-config.cjs",
    "electron:dist": "npm run build:web && electron-builder",
    "electron:dist:win": "npm run electron:dist -- --win",
    "electron:dist:mac": "npm run electron:dist -- --mac",
    "electron:dist:linux": "npm run electron:dist -- --linux",
    "electron:release:preflight": "node scripts/electron-release-preflight.mjs --require-signing",
    "electron:dist:release": "npm run electron:release:preflight && npm run electron:dist",
    "preelectron:dir": "node electron/write-runtime-config.cjs",
    "electron:dir": "npm run build:web && electron-builder --dir"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "44.2.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.hiretech.desktop",
    "productName": "HireTech",
    "directories": {
      "output": "release"
    },
    "files": [
      ".next/**",
      "public/**",
      "electron/**",
      "node_modules/next/**",
      "node_modules/react/**",
      "node_modules/react-dom/**",
      "package.json"
    ],
    "asar": true,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
